{
  "name": "@redspec/core",
  "version": "0.1.0-alpha.2",
  "description": "Specs made of artifacts that can go red: types, audit, lock, coverage, and decision-table analysis.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nateshernandez/redspec.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/nateshernandez/redspec/tree/main/packages/core#readme",
  "bugs": "https://github.com/nateshernandez/redspec/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "scripts": {
    "build": "tsup src/index.ts src/client.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fast-glob": "^3.3.3",
    "jiti": "^2.6.0"
  },
  "devDependencies": {
    "fast-check": "^4.9.0",
    "react": "^19.2.0",
    "@types/react": "^19.2.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
