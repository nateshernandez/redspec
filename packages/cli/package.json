{
  "name": "@redspec/cli",
  "version": "0.1.0-alpha.1",
  "description": "redspec: init, check, status, new, accept, sync, doctor.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nateshernandez/redspec.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/nateshernandez/redspec/tree/main/packages/cli#readme",
  "bugs": "https://github.com/nateshernandez/redspec/issues",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "redspec": "./bin/redspec.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@redspec/core": "workspace:*",
    "@redspec/method": "workspace:*",
    "commander": "^14.0.0",
    "picocolors": "^1.1.1"
  }
}
