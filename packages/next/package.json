{
  "name": "@redspec/next",
  "version": "0.1.0",
  "private": true,
  "description": "The redspec spec route, board, and production gate for Next.js 16.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./gate": {
      "types": "./dist/gate.d.ts",
      "default": "./dist/gate.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup && node scripts/assert-client-boundary.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@redspec/core": "workspace:*",
    "@xyflow/react": "^12.11.5"
  },
  "peerDependencies": {
    "next": ">=16",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "next": "^16.2.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
