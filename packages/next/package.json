{
  "name": "@redspec/next",
  "version": "0.1.0-alpha.2",
  "description": "The redspec spec route, board, and production gate for Next.js 16.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nateshernandez/redspec.git",
    "directory": "packages/next"
  },
  "homepage": "https://github.com/nateshernandez/redspec/tree/main/packages/next#readme",
  "bugs": "https://github.com/nateshernandez/redspec/issues",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./gate": {
      "types": "./dist/gate.d.ts",
      "default": "./dist/gate.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "scripts": {
    "build": "rm -rf dist && tsup && node scripts/assert-client-boundary.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@redspec/core": "workspace:*",
    "@xyflow/react": "^12.11.5"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "next": "^16.2.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "peerDependencies": {
    "next": ">=16",
    "react": ">=19",
    "react-dom": ">=19"
  }
}
