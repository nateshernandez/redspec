{
  "name": "redspec",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --filter './packages/*' typecheck",
    "lint": "prettier --check \"packages/**/*.{ts,tsx,md,json}\"",
    "format": "prettier --write \"packages/**/*.{ts,tsx,md,json}\"",
    "check": "pnpm build && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "prettier": "^3.8.3",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  }
}
