{
  "name": "@redspec/next",
  "version": "0.1.0",
  "private": true,
  "description": "The redspec spec route, board, and production gate for Next.js 16.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./board.css": "./dist/board.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --external react,react-dom,next && cp src/board/board.css dist/board.css",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@redspec/core": "workspace:*",
    "@xyflow/react": "^12.11.5"
  },
  "peerDependencies": {
    "next": ">=16",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "next": "^16.2.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
